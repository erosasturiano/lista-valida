{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/r/c",
      "destination": "https://bqjzyebbhboocytigacx.supabase.co/functions/v1/track-click"
    },
    {
      "source": "/r/o",
      "destination": "https://bqjzyebbhboocytigacx.supabase.co/functions/v1/track-open"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
